    { "id": "TG-APP", "name": "Applications", "workload": "Entra ID" },
    { "id": "TG-ROLE", "name": "Role Management", "workload": "Entra ID" },
    { "id": "TG-IDENTITY", "name": "Identity Governance", "workload": "Entra ID" },
    { "id": "TG-EXCHANGE", "name": "Exchange Online", "workload": "Exchange" },
    { "id": "TG-SHAREPOINT", "name": "SharePoint Online", "workload": "SharePoint" },
    { "id": "TG-TEAMS", "name": "Teams", "workload": "Teams" },
    { "id": "TG-DEFENDER", "name": "Defender", "workload": "Defender" },
    { "id": "TG-ONEDRIVE", "name": "OneDrive", "workload": "OneDrive" },
    { "id": "TG-DLP", "name": "Data Loss Prevention", "workload": "Compliance" },
    { "id": "TG-AUDIT", "name": "Audit & Logging", "workload": "Compliance" },
    { "id": "TG-GOVERNANCE", "name": "Governance", "workload": "Governance" },
    { "id": "TG-DEVICE", "name": "Device Security", "workload": "Intune" },
    { "id": "TG-NETWORK", "name": "Network Security", "workload": "Security" },
    { "id": "TG-COMPLIANCE", "name": "Compliance", "workload": "Compliance" },
    { "id": "TG-MONITORING", "name": "Monitoring", "workload": "Monitoring" },
    { "id": "TG-BACKUP", "name": "Backup & Recovery", "workload": "Resilience" },
    { "id": "TG-THREAT", "name": "Threat Protection", "workload": "Security" }
  ],
  "controls": [
    {
      "control_id": "CIS-2.1.1",
      "framework": "CIS",
      "title": "Ensure MFA is required for all users",
      "description": "Require multi-factor authentication for all users in the tenant",
      "domain": "TG-AUTH",
      "severity": "Critical",
      "validation_method": "Graph API",
      "graph_api_queries": ["/me/memberOf", "/organization/directory/settings"],
      "expected_values": "MFA required for all users",
      "remediation_steps": "Enable MFA requirement in Conditional Access policies"
    },
    {
      "control_id": "CIS-2.1.2",
      "framework": "CIS",
      "title": "Ensure MFA is required for administrative users",
      "description": "Require MFA for all administrative and privileged users",
      "domain": "TG-AUTH",
      "severity": "Critical",
      "validation_method": "Graph API",
      "graph_api_queries": ["/directoryRoles/getByIds"],
      "expected_values": "MFA enforced on admin accounts",
      "remediation_steps": "Create Conditional Access policy for admin roles"
    },
    {
      "control_id": "CIS-2.1.3",
      "framework": "CIS",
      "title": "Ensure that Legacy Authentication is blocked",
      "description": "Block legacy authentication protocols",
      "domain": "TG-AUTH",
      "severity": "High",
      "validation_method": "Graph API",
      "graph_api_queries": ["/identity/conditionalAccess/policies"],
      "expected_values": "Legacy auth blocked",
      "remediation_steps": "Configure Conditional Access to block legacy auth"
    },
    {
      "control_id": "CIS-2.1.4",
      "framework": "CIS",
      "title": "Ensure Password Policy is enabled",
      "description": "Ensure password policies are enforced",
      "domain": "TG-AUTH",
      "severity": "High",
      "validation_method": "PowerShell",
      "powershell_commands": ["Get-MsolPasswordPolicy"],
      "expected_values": "Strong password policy configured",
      "remediation_steps": "Set password policy via Set-MsolPasswordPolicy"
    },
    {
      "control_id": "CIS-2.1.5",
      "framework": "CIS",
      "title": "Ensure password expiration is enforced",
      "description": "Require password changes at regular intervals",
      "domain": "TG-AUTH",
      "severity": "Medium",
      "validation_method": "PowerShell",
      "powershell_commands": ["Get-MsolPasswordPolicy"],
      "expected_values": "Password expiration enabled",
      "remediation_steps": "Enable password expiration in password policy"
    },
    {
      "control_id": "CIS-2.1.6",
      "framework": "CIS",
      "title": "Ensure that external users are provisioned and deprovisioned correctly",
      "description": "Manage external user access properly",
      "domain": "TG-IDENTITY",
      "severity": "High",
      "validation_method": "Graph API",
      "graph_api_queries": ["/users?$filter=userType eq 'Guest'"],
      "expected_values": "Guest users properly managed",
      "remediation_steps": "Review and clean up guest accounts regularly"
    },
    {
      "control_id": "CIS-2.1.7",
      "framework": "CIS",
      "title": "Ensure that 'Block Microsoft accounts' is enabled",
      "description": "Prevent personal Microsoft accounts from accessing tenant",
      "domain": "TG-AUTH",
      "severity": "High",
      "validation_method": "Graph API",
      "graph_api_queries": ["/policies/authorizationPolicy"],
      "expected_values": "Personal accounts blocked",
      "remediation_steps": "Configure authorization policy to block MSA"
    },
    {
      "control_id": "CIS-2.1.8",
      "framework": "CIS",
      "title": "Ensure that Conditional Access policies are set up",
      "description": "Implement Conditional Access for security",
      "domain": "TG-CA",
      "severity": "High",
      "validation_method": "Graph API",
      "graph_api_queries": ["/identity/conditionalAccess/policies"],
      "expected_values": "Multiple CA policies defined",
      "remediation_steps": "Create CA policies for risk-based access"
    },
    {
      "control_id": "CIS-2.1.9",
      "framework": "CIS",
      "title": "Ensure Azure AD Identity Protection is enabled",
      "description": "Enable identity protection for risk detection",
      "domain": "TG-AUTH",
      "severity": "High",
      "validation_method": "Graph API",
      "graph_api_queries": ["/identity/riskDetection"],
      "expected_values": "Identity Protection active",
      "remediation_steps": "Enable Azure AD Identity Protection"
    },
    {
      "control_id": "CIS-2.1.10",
      "framework": "CIS",
      "title": "Ensure that User Risk Policy is configured",
      "description": "Configure user risk policies for protection",
      "domain": "TG-AUTH",
      "severity": "High",
      "validation_method": "Graph API",
      "graph_api_queries": ["/identity/riskyUsers"],
      "expected_values": "User risk policy active",
      "remediation_steps": "Configure risk-based policies"
    },
    {
      "control_id": "CIS-2.1.11",
      "framework": "CIS",
      "title": "Ensure that Sign-in Risk Policy is configured",
      "description": "Configure sign-in risk detection",
      "domain": "TG-AUTH",
      "severity": "High",
      "validation_method": "Graph API",
      "graph_api_queries": ["/identity/signInRisks"],
      "expected_values": "Sign-in risk policy active",
      "remediation_steps": "Enable sign-in risk detection"
    }
  ]
}
